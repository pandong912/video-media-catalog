{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video.world/contracts/catalog/global-reference-release.v1.schema.json",
  "title": "Global Research Catalog reference-only release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "authorityScope",
    "tenantWorldIdentityAuthority",
    "capabilities",
    "referenceSlices",
    "ontologyRegistryId",
    "ontologyRegistryVersion",
    "ontologyDigest",
    "predicateRegistryId",
    "predicateRegistryVersion",
    "predicateRegistryDigest",
    "sourcePolicySchemaVersion",
    "sourcePolicyRegistryVersion",
    "sourcePolicyDigest",
    "sourceSnapshots",
    "sliceSourcePins",
    "goldReleasePlanId",
    "goldReleasePlan",
    "goldReleaseCommit",
    "validatedIndex",
    "worldZeroWriteAttestation",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "releaseId": {"$ref": "#/$defs/sha256"},
    "previousReleaseId": {"$ref": "#/$defs/sha256"},
    "authorityScope": {"const": "GLOBAL_REFERENCE_ONLY"},
    "tenantWorldIdentityAuthority": {"const": false},
    "capabilities": {
      "type": "array",
      "prefixItems": [
        {"const": "DISPLAY"},
        {"const": "IDENTITY"},
        {"const": "RESEARCH"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "referenceSlices": {
      "type": "array",
      "prefixItems": [
        {"const": "LEARNING/INSTRUCTION"},
        {"const": "NEWS/JOURNALISM"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "ontologyRegistryId": {"const": "global-reference-ontology"},
    "ontologyRegistryVersion": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "ontologyDigest": {"$ref": "#/$defs/sha256"},
    "predicateRegistryId": {"const": "research-predicates"},
    "predicateRegistryVersion": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "predicateRegistryDigest": {"$ref": "#/$defs/sha256"},
    "sourcePolicySchemaVersion": {
      "const": "video.world.catalog-source-policy-registry.v1"
    },
    "sourcePolicyRegistryVersion": {"type": "string", "minLength": 1},
    "sourcePolicyDigest": {"$ref": "#/$defs/sha256"},
    "sourceSnapshots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceSnapshot"}
    },
    "sliceSourcePins": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/sliceSourcePin"},
            {
              "properties": {
                "referenceSlice": {"const": "LEARNING/INSTRUCTION"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sliceSourcePin"},
            {
              "properties": {
                "referenceSlice": {"const": "NEWS/JOURNALISM"}
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "goldReleasePlanId": {"$ref": "#/$defs/sha256"},
    "goldReleasePlan": {
      "allOf": [
        {"$ref": "#/$defs/objectRef"},
        {
          "properties": {
            "mediaType": {
              "const": "application/vnd.video-media-catalog.gold-release-plan.v2+json"
            }
          }
        }
      ]
    },
    "goldReleaseCommit": {
      "allOf": [
        {"$ref": "#/$defs/objectRef"},
        {
          "properties": {
            "mediaType": {
              "const": "application/vnd.video-media-catalog.gold-release-commit.v2+json"
            }
          }
        }
      ]
    },
    "validatedIndex": {"$ref": "#/$defs/validatedIndex"},
    "worldZeroWriteAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantCanonicalWriteCount",
        "worldMaterializationCount",
        "worldPublicationCount",
        "aliasActivationCount"
      ],
      "properties": {
        "tenantCanonicalWriteCount": {"const": 0},
        "worldMaterializationCount": {"const": 0},
        "worldPublicationCount": {"const": 0},
        "aliasActivationCount": {"const": 0}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "value"],
      "properties": {
        "algorithm": {"const": "CHECKSUM_ALGORITHM_SHA256"},
        "encoding": {"const": "CHECKSUM_ENCODING_HEX"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "format", "mediaType", "checksum", "sizeBytes"],
      "properties": {
        "uri": {"type": "string", "pattern": "^(file|s3)://"},
        "format": {
          "enum": [
            "OBJECT_FORMAT_JSON",
            "OBJECT_FORMAT_PARQUET",
            "OBJECT_FORMAT_OTHER"
          ]
        },
        "mediaType": {"type": "string", "minLength": 1},
        "checksum": {"$ref": "#/$defs/checksum"},
        "sizeBytes": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "pattern": "^[1-9][0-9]*$"}
          ]
        },
        "etag": {"type": "string", "minLength": 1},
        "objectVersion": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"uri": {"pattern": "^s3://"}}},
          "then": {"required": ["etag", "objectVersion"]}
        }
      ]
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pinId",
        "sourceSystemId",
        "sourceProductId",
        "connectorId",
        "revisionKind",
        "sourceRevision",
        "schemaId",
        "rawObjects",
        "capturedAt"
      ],
      "properties": {
        "pinId": {"$ref": "#/$defs/sha256"},
        "sourceSystemId": {"const": "wikidata"},
        "sourceProductId": {"const": "wikidata-json-dump"},
        "connectorId": {"const": "wikidata-full-media-backfill"},
        "revisionKind": {"const": "DUMP_OBJECT"},
        "sourceRevision": {"type": "string", "minLength": 1},
        "schemaId": {"const": "wikidata-global-reference-entity"},
        "rawObjects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/objectRef"}
        },
        "capturedAt": {"type": "string", "format": "date-time"}
      }
    },
    "sliceSourcePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceSlice", "sourceSnapshotPinId"],
      "properties": {
        "referenceSlice": {
          "enum": ["NEWS/JOURNALISM", "LEARNING/INSTRUCTION"]
        },
        "sourceSnapshotPinId": {"$ref": "#/$defs/sha256"}
      }
    },
    "validatedIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId",
        "releasePlanId",
        "concreteIndex",
        "readAlias",
        "mappingDigest",
        "configDigest",
        "documentCount",
        "buildManifest",
        "validationReceipt"
      ],
      "properties": {
        "buildId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "releasePlanId": {"$ref": "#/$defs/sha256"},
        "concreteIndex": {
          "type": "string",
          "pattern": "^media-catalog-research-[0-9a-f]{24}$"
        },
        "readAlias": {"const": "media-catalog-research-read"},
        "mappingDigest": {"$ref": "#/$defs/sha256"},
        "configDigest": {"$ref": "#/$defs/sha256"},
        "documentCount": {"type": "integer", "minimum": 0},
        "buildManifest": {
          "allOf": [
            {"$ref": "#/$defs/objectRef"},
            {
              "properties": {
                "mediaType": {
                  "const": "application/vnd.video-media-catalog.gold-index-build.v2+json"
                }
              }
            }
          ]
        },
        "validationReceipt": {
          "allOf": [
            {"$ref": "#/$defs/objectRef"},
            {
              "properties": {
                "mediaType": {
                  "const": "application/vnd.video-media-catalog.gold-index-validation.v2+json"
                }
              }
            }
          ]
        }
      }
    }
  }
}
