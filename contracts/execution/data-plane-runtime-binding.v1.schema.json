{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-plane-runtime-binding.v1.schema.json",
  "title": "DataPlane runtime binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeBindingId",
    "tenantId",
    "projectId",
    "dataPlaneBindingId",
    "dataPlaneId",
    "objectProvider",
    "runtimeProvider",
    "runtimeRegion",
    "workloadIdentityKind",
    "workloadIdentityRef",
    "workloadIdentityDigest",
    "executionProfileDigest",
    "exactVersionOnly",
    "state",
    "revision",
    "bindingDigest",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "video.world.data-plane-runtime-binding.v1"
    },
    "runtimeBindingId": {
      "$ref": "#/$defs/uuid"
    },
    "tenantId": {
      "$ref": "#/$defs/uuid"
    },
    "projectId": {
      "$ref": "#/$defs/uuid"
    },
    "dataPlaneBindingId": {
      "$ref": "#/$defs/uuid"
    },
    "dataPlaneId": {
      "$ref": "#/$defs/uuid"
    },
    "objectProvider": {
      "enum": [
        "AWS_S3",
        "ALIBABA_OSS"
      ]
    },
    "runtimeProvider": {
      "enum": [
        "AWS_EKS",
        "ALIYUN_ACK",
        "AWS_EMR_SERVERLESS",
        "ALIYUN_EMR_SERVERLESS",
        "AWS_RESIDENT_RAY",
        "ALIYUN_RESIDENT_RAY",
        "PLATFORM_CONTROL",
        "PLATFORM_HUMAN",
        "TEMPORAL_EXTERNAL"
      ]
    },
    "runtimeRegion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,7}$"
    },
    "workloadIdentityKind": {
      "enum": [
        "AWS_IAM_ROLE",
        "ALIYUN_RAM_ROLE",
        "KUBERNETES_SERVICE_ACCOUNT",
        "TEMPORAL_NAMESPACE",
        "PLATFORM_SERVICE"
      ]
    },
    "workloadIdentityRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "(?i:secret|token=|password)"
      }
    },
    "workloadIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "executionProfileDigest": {
      "$ref": "#/$defs/digest"
    },
    "exactVersionOnly": {
      "const": true
    },
    "state": {
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "bindingDigest": {
      "$ref": "#/$defs/digest"
    },
    "createdAt": {
      "$ref": "#/$defs/instant"
    },
    "updatedAt": {
      "$ref": "#/$defs/instant"
    },
    "revokedAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "REVOKED"
          }
        }
      },
      "then": {
        "required": [
          "revokedAt"
        ]
      },
      "else": {
        "not": {
          "required": [
            "revokedAt"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "objectProvider": {
            "const": "AWS_S3"
          }
        }
      },
      "then": {
        "properties": {
          "runtimeProvider": {
            "enum": [
              "AWS_EKS",
              "AWS_EMR_SERVERLESS",
              "AWS_RESIDENT_RAY",
              "PLATFORM_CONTROL",
              "PLATFORM_HUMAN",
              "TEMPORAL_EXTERNAL"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "runtimeProvider": {
            "enum": [
              "ALIYUN_ACK",
              "ALIYUN_EMR_SERVERLESS",
              "ALIYUN_RESIDENT_RAY",
              "PLATFORM_CONTROL",
              "PLATFORM_HUMAN",
              "TEMPORAL_EXTERNAL"
            ]
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "workloadIdentityKind": {
              "const": "AWS_IAM_ROLE"
            },
            "workloadIdentityRef": {
              "pattern": "^arn:aws(?:-[a-z]+)?:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,256}$"
            }
          }
        },
        {
          "properties": {
            "workloadIdentityKind": {
              "const": "ALIYUN_RAM_ROLE"
            },
            "workloadIdentityRef": {
              "pattern": "^acs:ram::[0-9]{4,32}:role/[A-Za-z0-9._/-]{1,256}$"
            }
          }
        },
        {
          "properties": {
            "workloadIdentityKind": {
              "const": "KUBERNETES_SERVICE_ACCOUNT"
            },
            "workloadIdentityRef": {
              "pattern": "^system:serviceaccount:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
            }
          }
        },
        {
          "properties": {
            "workloadIdentityKind": {
              "const": "TEMPORAL_NAMESPACE"
            },
            "workloadIdentityRef": {
              "pattern": "^temporal:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
            }
          }
        },
        {
          "properties": {
            "workloadIdentityKind": {
              "const": "PLATFORM_SERVICE"
            },
            "workloadIdentityRef": {
              "pattern": "^spiffe://[a-z0-9.-]+/[A-Za-z0-9._/-]{1,384}$"
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "runtimeProvider": {
              "const": "AWS_EKS"
            },
            "workloadIdentityKind": {
              "enum": [
                "AWS_IAM_ROLE",
                "KUBERNETES_SERVICE_ACCOUNT"
              ]
            }
          }
        },
        {
          "properties": {
            "runtimeProvider": {
              "const": "ALIYUN_ACK"
            },
            "workloadIdentityKind": {
              "enum": [
                "ALIYUN_RAM_ROLE",
                "KUBERNETES_SERVICE_ACCOUNT"
              ]
            }
          }
        },
        {
          "properties": {
            "runtimeProvider": {
              "enum": [
                "AWS_EMR_SERVERLESS",
                "AWS_RESIDENT_RAY"
              ]
            },
            "workloadIdentityKind": {
              "const": "AWS_IAM_ROLE"
            }
          }
        },
        {
          "properties": {
            "runtimeProvider": {
              "enum": [
                "ALIYUN_EMR_SERVERLESS",
                "ALIYUN_RESIDENT_RAY"
              ]
            },
            "workloadIdentityKind": {
              "const": "ALIYUN_RAM_ROLE"
            }
          }
        },
        {
          "properties": {
            "runtimeProvider": {
              "enum": [
                "PLATFORM_CONTROL",
                "PLATFORM_HUMAN"
              ]
            },
            "workloadIdentityKind": {
              "const": "PLATFORM_SERVICE"
            }
          }
        },
        {
          "properties": {
            "runtimeProvider": {
              "const": "TEMPORAL_EXTERNAL"
            },
            "workloadIdentityKind": {
              "const": "TEMPORAL_NAMESPACE"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "dataPlaneRuntimeBindingHashProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "projectId",
        "dataPlaneBindingId",
        "dataPlaneId",
        "objectProvider",
        "runtimeProvider",
        "runtimeRegion",
        "workloadIdentityKind",
        "workloadIdentityRef",
        "workloadIdentityDigest",
        "executionProfileDigest",
        "exactVersionOnly"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "projectId": {
          "$ref": "#/$defs/uuid"
        },
        "dataPlaneBindingId": {
          "$ref": "#/$defs/uuid"
        },
        "dataPlaneId": {
          "$ref": "#/$defs/uuid"
        },
        "objectProvider": {
          "type": "string"
        },
        "runtimeProvider": {
          "type": "string"
        },
        "runtimeRegion": {
          "type": "string"
        },
        "workloadIdentityKind": {
          "type": "string"
        },
        "workloadIdentityRef": {
          "type": "string"
        },
        "workloadIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "executionProfileDigest": {
          "$ref": "#/$defs/digest"
        },
        "exactVersionOnly": {
          "type": "boolean"
        }
      }
    }
  },
  "x-hash-algorithm": "video.world.canonical-tuple.sha256-length-delimited-utf8.v1",
  "x-hash-projection": {
    "$ref": "#/$defs/dataPlaneRuntimeBindingHashProjection",
    "domain": "video.world.data-plane-runtime-binding.v1",
    "excluded": [
      "schemaVersion",
      "runtimeBindingId",
      "state",
      "revision",
      "bindingDigest",
      "createdAt",
      "updatedAt",
      "revokedAt"
    ]
  }
}
