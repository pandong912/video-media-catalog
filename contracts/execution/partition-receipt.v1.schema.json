{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partition-receipt.v1.schema.json",
  "title": "Video World Partition Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "tenantId",
    "executionAttemptId",
    "executionPlanId",
    "executionPartitionId",
    "planDigest",
    "inputManifestDigest",
    "producerDigest",
    "result",
    "producedAt",
    "recordedAt",
    "semanticDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receiptId": {
      "$ref": "#/$defs/uuidV7"
    },
    "tenantId": {
      "$ref": "#/$defs/uuidV7"
    },
    "executionAttemptId": {
      "$ref": "#/$defs/uuidV7"
    },
    "executionPlanId": {
      "$ref": "#/$defs/uuidV7"
    },
    "executionPartitionId": {
      "$ref": "#/$defs/uuidV7"
    },
    "planDigest": {
      "$ref": "#/$defs/sha256"
    },
    "inputManifestDigest": {
      "$ref": "#/$defs/sha256"
    },
    "producerDigest": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/worldStagedResult"
        },
        {
          "$ref": "#/$defs/humanDecisionResult"
        },
        {
          "$ref": "#/$defs/externalAuthorityResult"
        }
      ]
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "semanticDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$comment": "result is a strict oneOf tagged union. semanticDigest uses canonical tuple v1 over partitionReceiptHashProjection, which excludes semanticDigest, recordedAt, and receipt transport identity to prevent self-reference.",
  "x-hash-algorithm": "video.world.canonical-tuple.sha256-length-delimited-utf8.v1",
  "x-hash-projection": {
    "$ref": "#/$defs/partitionReceiptHashProjection",
    "excluded": [
      "semanticDigest",
      "recordedAt",
      "receiptBytesChecksum",
      "receiptEtag",
      "receiptVersionToken"
    ]
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worldStagedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "objects",
        "outputDigest",
        "schemaDigest",
        "recordCount",
        "byteCount",
        "resultDigest"
      ],
      "properties": {
        "kind": {
          "const": "WORLD_STAGED"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "object-ref-v2.v2.schema.json"
          }
        },
        "outputDigest": {
          "$ref": "#/$defs/sha256"
        },
        "schemaDigest": {
          "$ref": "#/$defs/sha256"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1125899906842624
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1125899906842624
        },
        "resultDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "humanDecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workItemId",
        "finalRevision",
        "decision",
        "actorAuthorityDigest",
        "rubricDigest",
        "evidenceDigest",
        "artifactFactBindingDigests",
        "resultDigest"
      ],
      "properties": {
        "kind": {
          "const": "HUMAN_DECISION"
        },
        "workItemId": {
          "$ref": "#/$defs/uuidV7"
        },
        "finalRevision": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "actorAuthorityDigest": {
          "$ref": "#/$defs/sha256"
        },
        "rubricDigest": {
          "$ref": "#/$defs/sha256"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "artifactFactBindingDigests": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "resultDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "externalAuthorityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authorityKind",
        "authorityId",
        "authorityResultDigest",
        "completionReceiptObject",
        "completionReceiptDigest",
        "resultDigest"
      ],
      "properties": {
        "kind": {
          "const": "EXTERNAL_AUTHORITY"
        },
        "authorityKind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "authorityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "authorityResultDigest": {
          "$ref": "#/$defs/sha256"
        },
        "completionReceiptObject": {
          "$ref": "object-ref-v2.v2.schema.json"
        },
        "completionReceiptDigest": {
          "$ref": "#/$defs/sha256"
        },
        "resultDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "partitionReceiptHashProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "receiptId",
        "tenantId",
        "executionAttemptId",
        "executionPlanId",
        "executionPartitionId",
        "planDigest",
        "inputManifestDigest",
        "producerDigest",
        "resultKind",
        "resultDigest",
        "producedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "receiptId": {
          "$ref": "#/$defs/uuidV7"
        },
        "tenantId": {
          "$ref": "#/$defs/uuidV7"
        },
        "executionAttemptId": {
          "$ref": "#/$defs/uuidV7"
        },
        "executionPlanId": {
          "$ref": "#/$defs/uuidV7"
        },
        "executionPartitionId": {
          "$ref": "#/$defs/uuidV7"
        },
        "planDigest": {
          "$ref": "#/$defs/sha256"
        },
        "inputManifestDigest": {
          "$ref": "#/$defs/sha256"
        },
        "producerDigest": {
          "$ref": "#/$defs/sha256"
        },
        "resultKind": {
          "enum": ["WORLD_STAGED", "HUMAN_DECISION", "EXTERNAL_AUTHORITY"]
        },
        "resultDigest": {
          "$ref": "#/$defs/sha256"
        },
        "producedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
